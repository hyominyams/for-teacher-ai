{
  "manifest_version": 3,
  "name": "ForTeacher AI NEIS Uploader",
  "description": "ForTeacher AI 저장 데이터와 CSV·XLSX 파일의 학생별 기록을 나이스에 붙여넣습니다.",
  "version": "0.1.16",
  "background": { "service_worker": "panel-session.js" },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["activeTab", "scripting", "storage", "clipboardRead", "tabs"],
  "host_permissions": ["https://for-teacher-ai.vercel.app/*"],
  "action": {
    "default_title": "NEIS Upload",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://for-teacher-ai.vercel.app/extension/bridge*"],
      "js": ["bridge-content.js"],
      "run_at": "document_idle"
    }
  ]
}
